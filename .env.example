# Local provider credentials — copy to .env.local and fill in what you have.
# Usage/cost endpoints require organization Admin keys, not project keys.
# Restart the dev server after changing this file.

# OpenAI (https://platform.openai.com/settings/organization/admin-keys)
OPENAI_ADMIN_API_KEY=

# Anthropic (https://platform.claude.com/settings/organization/admin-keys)
ANTHROPIC_ADMIN_API_KEY=
# Optional — only if the key belongs to multiple organizations:
ANTHROPIC_ORGANIZATION_ID=
